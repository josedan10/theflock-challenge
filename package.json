{
  "name": "twitter-clone-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "compose:down": "docker compose --profile dev down",
    "compose:logs": "docker compose --profile dev logs -f",
    "compose:ps": "docker compose --profile dev ps",
    "compose:up": "docker compose --profile dev up -d --build --wait",
    "db:generate": "pnpm --filter @twitter-clone/api db:generate",
    "db:migrate": "pnpm --filter @twitter-clone/api db:migrate",
    "db:up": "docker compose --profile dev up -d --wait postgres",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run lint:config && turbo run lint",
    "lint:config": "eslint eslint.config.mjs && bash scripts/test-eslint-config.sh",
    "prepare": "simple-git-hooks",
    "stack:up": "bash scripts/setup.sh",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:scripts": "bats tests/bats",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{cjs,css,json,md,mjs,ts,tsx,yaml,yml}": "prettier --check"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": "0.25.12",
      "glob@>=9.0.0 <=14.0.1": "14.0.6",
      "minimatch@>=7.0.0 <11.0.1": "11.0.9"
    },
    "patchedDependencies": {
      "undici@8.13.1": "patches/undici@8.13.1.patch"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsdoc": "65.5.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lint-staged": "16.1.6",
    "prettier": "3.10.1",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "typescript-eslint": "8.74.0",
    "vitest": "catalog:"
  }
}
