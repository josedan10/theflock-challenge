# Runtime
NODE_ENV=development
# Local Compose stack profile (dev | prod). See compose.yaml and compose.prod.yaml.
COMPOSE_PROFILES=dev
LOG_LEVEL=debug

# Local URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000
API_PORT=4000

# PostgreSQL (development-only defaults; replace every production secret)
POSTGRES_DB=twitter_clone
POSTGRES_USER=twitter_clone
POSTGRES_PASSWORD=twitter_clone_local_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql://twitter_clone:twitter_clone_local_only@localhost:5433/twitter_clone

# Authentication: generate with `openssl rand -base64 48`
SESSION_SECRET=replace_me_with_at_least_32_characters
SESSION_TTL_SECONDS=604800

# Browser/API boundary
CORS_ORIGIN=http://localhost:3000
# Proxies allowed to set X-Forwarded-For: IPs, CIDRs, or loopback/linklocal/uniquelocal
# (e.g. "loopback" when Caddy runs on the same host). Leave empty locally.
# "true" and hop counts are rejected: they allow spoofing or are ignored by Fastify.
TRUST_PROXY=
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Optional/bonus features (leave disabled until their milestone)
REALTIME_ENABLED=false
# Tweet images (IMG-01). Set both to true and choose a directory outside the repo.
UPLOADS_ENABLED=false
NEXT_PUBLIC_UPLOADS_ENABLED=false
MEDIA_STORAGE_DIR=.data/media
# Origin written into image URLs. No path. Must match the API the browser calls.
PUBLIC_API_ORIGIN=http://localhost:4000
NOTIFICATIONS_ENABLED=false

# Tweet create/delete attempts per client per minute (default 20).
# Browser tests raise it; keep the default in real environments.
TWEET_RATE_LIMIT_PER_MINUTE=20

# Number of demo accounts created by local setup (10–100)
SEED_USER_COUNT=10

# Local activity simulator (DEV-01). Demo accounts post and reply through the
# API. Off by default; setup starts it when true. Seconds between actions: 15–3600.
ACTIVITY_SIMULATOR=false
ACTIVITY_INTERVAL_SECONDS=30
