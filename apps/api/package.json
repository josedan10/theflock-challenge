{
  "name": "@twitter-clone/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/sensible": "^6.0.8",
    "@twitter-clone/contracts": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "postgres": "^4.1.1",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.2"
  }
}
