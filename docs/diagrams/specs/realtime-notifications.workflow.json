{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Real-Time Timeline and Notifications Workflow",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "web",
      "label": "Connected Browser"
    },
    {
      "id": "api",
      "label": "API and SSE"
    },
    {
      "id": "db",
      "label": "PostgreSQL"
    }
  ],
  "mainPath": ["action", "transaction", "sse", "refresh"],
  "nodes": [
    {
      "id": "action",
      "lane": "web",
      "col": 0,
      "type": "frontend",
      "label": "Social Action",
      "sublabel": "tweet, like, follow",
      "width": 150
    },
    {
      "id": "refresh",
      "lane": "web",
      "col": 4,
      "type": "frontend",
      "label": "Refetch Authority",
      "sublabel": "dedupe + announce",
      "width": 150
    },
    {
      "id": "transaction",
      "lane": "api",
      "col": 1,
      "type": "backend",
      "label": "Domain Transaction",
      "sublabel": "write state + notify",
      "width": 150
    },
    {
      "id": "sse",
      "lane": "api",
      "col": 3,
      "type": "messagebus",
      "label": "SSE Event",
      "sublabel": "tweet IDs only",
      "width": 150
    },
    {
      "id": "catchup",
      "lane": "api",
      "col": 4,
      "type": "messagebus",
      "label": "Cursor Catch-Up",
      "sublabel": "Last-Event-ID",
      "width": 150
    },
    {
      "id": "tweets",
      "lane": "db",
      "col": 2,
      "type": "database",
      "label": "Tweets + Notifications",
      "sublabel": "durable log",
      "width": 150
    }
  ],
  "edges": [
    {
      "from": "action",
      "to": "transaction",
      "role": "main"
    },
    {
      "from": "transaction",
      "to": "tweets",
      "label": "commit",
      "role": "branch"
    },
    {
      "from": "transaction",
      "to": "sse",
      "label": "in-process fan-out",
      "role": "main"
    },
    {
      "from": "sse",
      "to": "refresh",
      "label": "event ID",
      "role": "main"
    },
    {
      "from": "sse",
      "to": "catchup",
      "label": "disconnect",
      "role": "error",
      "variant": "dashed"
    },
    {
      "from": "catchup",
      "to": "tweets",
      "label": "newer than cursor",
      "role": "branch"
    },
    {
      "from": "catchup",
      "to": "refresh",
      "label": "missed ids",
      "role": "return"
    }
  ]
}
